# Token bot Discord (dari discord.com/developers -> Applications -> Bot)
DISCORD_BOT_TOKEN=

# Target undangan buat dapet hadiah
INVITE_GOAL=10

# Teks hadiah yang muncul pas target tercapai
REWARD_TEXT=klaim hadiah ke owner

# Channel buat pengumuman hadiah (opsional, kosongin = DM ke pemenang)
REWARD_CHANNEL_ID=

# File state (biasanya gak perlu diganti)
STATE_FILE=invite_state.json
